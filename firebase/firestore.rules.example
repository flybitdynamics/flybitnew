rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /contentStories/{storyId} {
      allow read: if resource.data.status == 'published' || request.auth != null;
      allow write: if request.auth != null;
    }

    match /contentBlogs/{blogId} {
      allow read: if resource.data.status == 'published' || resource.data.published == true || request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
